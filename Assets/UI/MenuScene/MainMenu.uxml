<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MenuScene/MainStyle.uss?fileID=7433441132597879392&amp;guid=a46f9fb4beed3ce4192b6c9e4f52dad6&amp;type=3#MainStyle" />
    <ui:VisualElement name="Main" style="flex-grow: 1; background-color: rgb(0, 0, 0); background-image: url(&quot;project://database/Assets/Images/background.jpg?fileID=2800000&amp;guid=baee527e9ab0a6f43a1cfa04771511d5&amp;type=3#background&quot;);">
        <ui:VisualElement name="Header" class="styleMain" style="flex-grow: 1;">
            <ui:Label tabindex="-1" text="Tittle of this game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Tittle" class="tittle" />
            <ui:Label tabindex="-1" text="Some Description here" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Description" style="-unity-text-align: upper-center;" />
        </ui:VisualElement>
        <ui:VisualElement name="Body" class="styleMain" style="flex-grow: 1; align-items: stretch; justify-content: space-around; flex-direction: row; flex-wrap: nowrap;">
            <ui:VisualElement name="MainButtons" style="flex-grow: 1;">
                <ui:Button text="Play" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Play" class="button-custom" />
                <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Settings" class="button-custom" />
                <ui:Button text="About" parse-escape-sequences="true" display-tooltip-when-elided="true" name="About" class="button-custom" />
                <ui:Button text="Credits" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Credits" class="button-custom" />
                <ui:Button text="Exit" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Exit" class="button-custom" />
            </ui:VisualElement>
            <ui:VisualElement name="SecondaryBody" style="flex-grow: 1; background-color: rgba(0, 255, 33, 0); width: 70%;">
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" class="button-custom" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="styleMain" style="flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
